# STAGED STARTER ONLY. Not installed, commissioned, or HA-runtime validated.
# Read docs/workstreams/guest-mode.md before adapting this into HA packages.
# Requires the future Porchlight guest receiver and guest-only web surface.
# Replace the entity IDs, MQTT node/base topic, HA birth/will topic, units,
# labels, and TV presenter for the actual installation. No credentials here.

input_boolean:
  porchlight_guest_mode_ready:
    name: Porchlight guest mode commissioned
    icon: mdi:tools
    initial: false
  porchlight_guest_mode_requested:
    name: Porchlight guest mode requested
    initial: false

input_text:
  porchlight_guest_session:
    name: Porchlight guest session
    initial: "inactive"
    max: 100

mqtt:
  - switch:
      name: Guest Mode
      default_entity_id: switch.porchlight_guest_mode
      unique_id: porchlight_guest_mode
      icon: mdi:account-group
      device:
        identifiers: [porchlight] # Match the appliance's HA_NODE_ID exactly.
        name: Porchlight LAN Directory
      command_topic: porchlight/cmd/guest_mode/set
      state_topic: porchlight/guest/requested
      payload_on: "ON"
      payload_off: "OFF"
      optimistic: false
      qos: 1
      retain: false # Commands must never be retained.
      availability_mode: all
      availability:
        - topic: homeassistant/status # Confirm the HA MQTT birth/will topic.
        - topic: porchlight/guest/controller/availability
        - topic: porchlight/guest/availability # Future receiver's Last Will.

script:
  porchlight_guest_present_on_tv:
    alias: Porchlight guest TV adapter — commissioning required
    mode: restart
    sequence:
      - stop: >-
          TV adapter is not implemented. Replace this guard only after mapping
          the Vizio entity and a working browser/kiosk or supported cast path.
        error: true
      # Implement a bounded, cancellable sequence here:
      # 1. Confirm requested mode and commissioning are still ON.
      # 2. media_player.turn_on the confirmed Vizio entity if needed.
      # 3. Wait up to 30 seconds for the TV to be on; report timeout explicitly.
      # 4. Recheck mode/session, select the confirmed input, open /guest/ on the
      #    actual presenter, then wait for a matching presentation heartbeat.
      # Do not assume media_player.play_media can display arbitrary HTML URLs.
      # Report failures as guest diagnostics; never mark the display active
      # solely because the TV turned on. OFF cancels this script below.

automation:
  - id: porchlight_guest_command
    alias: Porchlight guest mode — accept exact switch commands
    mode: queued
    max: 10
    triggers:
      - trigger: mqtt
        topic: porchlight/cmd/guest_mode/set
    conditions:
      - condition: template
        value_template: "{{ trigger.payload in ['ON', 'OFF'] }}"
    actions:
      - choose:
          - conditions: "{{ trigger.payload == 'OFF' }}"
            sequence:
              - action: input_boolean.turn_off
                target:
                  entity_id: input_boolean.porchlight_guest_mode_requested
          - conditions:
              - condition: template
                value_template: "{{ trigger.payload == 'ON' }}"
              - condition: state
                entity_id: input_boolean.porchlight_guest_mode_ready
                state: "on"
              - condition: state
                entity_id: input_boolean.porchlight_guest_mode_requested
                state: "off"
            sequence:
              - action: input_text.set_value
                target:
                  entity_id: input_text.porchlight_guest_session
                data:
                  value: "{{ utcnow().isoformat() }}"
              - action: input_boolean.turn_on
                target:
                  entity_id: input_boolean.porchlight_guest_mode_requested

  - id: porchlight_guest_decommission
    alias: Porchlight guest mode — clear mode when commissioning is removed
    triggers:
      - trigger: state
        entity_id: input_boolean.porchlight_guest_mode_ready
        to: "off"
    actions:
      - action: input_boolean.turn_off
        target:
          entity_id: input_boolean.porchlight_guest_mode_requested

  - id: porchlight_guest_tv_transition
    alias: Porchlight guest mode — TV presentation transition
    mode: restart
    triggers:
      - trigger: state
        entity_id: input_boolean.porchlight_guest_mode_requested
        to: "on"
      - trigger: state
        entity_id: input_boolean.porchlight_guest_mode_requested
        to: "off"
    actions:
      - action: script.turn_off
        target:
          entity_id: script.porchlight_guest_present_on_tv
      - if:
          - condition: state
            entity_id: input_boolean.porchlight_guest_mode_requested
            state: "on"
          - condition: state
            entity_id: input_boolean.porchlight_guest_mode_ready
            state: "on"
        then:
          - action: script.turn_on
            target:
              entity_id: script.porchlight_guest_present_on_tv
      # OFF hides content via the projection below; intentionally no TV power-off.

  - id: porchlight_guest_publish
    alias: Porchlight guest mode — publish limited presentation and heartbeat
    mode: restart
    triggers:
      - trigger: homeassistant
        event: start
      - trigger: time_pattern
        seconds: "/15"
      - trigger: state
        entity_id:
          - input_boolean.porchlight_guest_mode_ready
          - input_boolean.porchlight_guest_mode_requested
          - climate.replace_me
    actions:
      - variables:
          guest_enabled: >-
            {{ is_state('input_boolean.porchlight_guest_mode_ready', 'on')
               and is_state('input_boolean.porchlight_guest_mode_requested', 'on') }}
      - action: mqtt.publish
        data:
          topic: porchlight/guest/presentation
          qos: 1
          retain: false
          payload: >-
            {% set entity = 'climate.replace_me' %}
            {% set mode = states(entity) %}
            {% set available = mode not in ['unknown', 'unavailable'] %}
            {{ {
              'schema_version': 1,
              'enabled': guest_enabled | bool,
              'generated_at': utcnow().isoformat(),
              'session_id': states('input_text.porchlight_guest_session'),
              'hvac': [{
                'id': entity,
                'label': 'Example guest area',
                'available': available,
                'current_temperature': (state_attr(entity, 'current_temperature') | float(none)) if available else none,
                'target_temperature': (state_attr(entity, 'temperature') | float(none)) if available else none,
                'target_temperature_low': (state_attr(entity, 'target_temp_low') | float(none)) if available else none,
                'target_temperature_high': (state_attr(entity, 'target_temp_high') | float(none)) if available else none,
                'unit': '°F',
                'mode': mode if available else none,
                'action': state_attr(entity, 'hvac_action') if available else none
              }] if guest_enabled | bool else []
            } | to_json }}
      - action: mqtt.publish
        data:
          topic: porchlight/guest/requested
          payload: "{{ 'ON' if guest_enabled | bool else 'OFF' }}"
          qos: 1
          retain: true
      - action: mqtt.publish
        data:
          topic: porchlight/guest/controller/availability
          payload: >-
            {{ 'online' if is_state('input_boolean.porchlight_guest_mode_ready', 'on') else 'offline' }}
          qos: 1
          retain: true

# Commissioning notes:
# - This intentionally has no Alexa config; use the existing integration and
#   expose only the actual switch entity (confirm its ID in HA's registry).
# - Clear any old retained command on porchlight/cmd/guest_mode/set before
#   enabling these automations. Only switch commands use this topic.
# - The receiver must have a real Last Will and expiry; the older bridge's
#   retained online state is not a substitute for guest receiver availability.
# - OFF may take one heartbeat interval if an immediate publish fails; the
#   receiver/browser must hide content after the 45-second freshness deadline.
# - Add a diagnostic entity for the future guest/status acknowledgement. Switch
#   ON currently means requested mode only, never confirmed TV presentation.
# - Add more climate zones explicitly; do not publish all HA states/attributes.
