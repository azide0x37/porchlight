#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


SCRIPT = Path(__file__).resolve()
sys.path.insert(0, str(SCRIPT.parents[1] / "src"))
sys.path.insert(0, str(SCRIPT.parent))

from porchlight.ai_analysis import run_ai_analysis
from porchlight.config import load_config


def main() -> int:
    parser = argparse.ArgumentParser(prog="porchlight-ai-analysis")
    parser.add_argument("--apply", action="store_true")
    args = parser.parse_args()
    result = run_ai_analysis(load_config(apply=args.apply))
    summary = {
        key: result.get(key)
        for key in ("status", "model", "service_tier", "cache_hit", "analysis_stale", "error")
        if result.get(key) is not None
    }
    print(json.dumps(summary, sort_keys=True))
    return 0 if result.get("status") in {"ok", "disabled"} else 1


if __name__ == "__main__":
    raise SystemExit(main())
