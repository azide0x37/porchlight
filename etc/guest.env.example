# Separate from the administrative dashboard. Keep loopback until routing is ready.
GUEST_WEB_HOST=127.0.0.1
GUEST_WEB_PORT=8766
# Broker host/credentials/base topic come from porchlight.mqtt.env.
# Optional TLS files (server identity verification is always enabled):
# MQTT_CAFILE=/etc/porchlight/mqtt-ca.pem
# MQTT_CERTFILE=/etc/porchlight/mqtt-client.pem
# MQTT_KEYFILE=/etc/porchlight/mqtt-client.key
